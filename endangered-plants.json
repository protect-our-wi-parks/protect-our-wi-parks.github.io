    {
      "scientificName": "Asclepias purpurascens",
      "otherNames": [],
      "commonName": "Purple milkweed",
      "category": "endangered",
      "dnrPage": "https://apps.dnr.wi.gov/biodiversity/Home/detail/plants/8680",
      "frontPage": 4,
